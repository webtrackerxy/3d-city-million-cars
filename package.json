{
  "name": "3d-city-million-cars",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Web-based 3D city with 100,000 moving vehicles (MapLibre + Three.js). Asset pipeline scripts live in scripts/.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise src scripts tooling server",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run deps:check && npm run test",
    "assets:generate": "sh -c '\"${BLENDER:-/Applications/Blender.app/Contents/MacOS/Blender}\" --background --python scripts/generate-car-lods.py -- --config scripts/lod-config.json'",
    "assets:optimize": "node scripts/optimize-assets.ts",
    "assets:validate": "node scripts/validate-assets.ts",
    "assets:previews": "sh scripts/render-lod-previews.sh",
    "assets": "npm run assets:generate && npm run assets:optimize && npm run assets:validate && npm run assets:previews",
    "bench": "node scripts/run-benchmarks.ts",
    "diag": "node tooling/page-diagnostics.mjs",
    "roads": "node scripts/build-roads.ts --all",
    "probe": "node tooling/map-probe.mjs",
    "server": "tsx server/traffic-server.ts",
    "net:bench": "tsx server/net-bench.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@gltf-transform/functions": "^4.5.0",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^18.3.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "meshoptimizer": "^1.2.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.7",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "3d-tiles-renderer": "^0.5.2",
    "maplibre-gl": "^6.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "three": "^0.186.0",
    "ws": "^8.21.3"
  }
}
